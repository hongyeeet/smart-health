# Copy this file to .env (git ignores .env) and fill in your own values. Never commit .env.
# The Supabase values are shared with the team through a private channel, never through git or chat logs.

# Kaggle API token, used by scripts/download_data.py for the Kaggle datasets.
# Create it at https://www.kaggle.com/settings (API section). Paste only the token, no quotes.
KAGGLE_API_TOKEN=

# Supabase (the team's one shared project). Backend and scripts only: never put these in apps/web.
# Postgres connection string: Supabase dashboard > Connect > Session pooler (works on IPv4 networks).
# Replace [YOUR-PASSWORD] with the database password; URL-encode symbols such as @ # / in it.
DATABASE_URL=
# Project URL: Project Settings > API > Project URL (looks like https://<ref>.supabase.co).
SUPABASE_URL=
# Secret key: Project Settings > API Keys > the Secret key (its name starts with sb and it says secret) or the legacy service_role key.
# It bypasses row-level security. Server-side only.
SUPABASE_SERVICE_KEY=
# Private Storage bucket for original files (Bronze layer).
STORAGE_BACKEND=supabase
STORAGE_BUCKET=smart-health-originals
# Size of the embedding vectors in knowledge_chunks (and later memory_episodes).
# Placeholder until the AI provider is chosen (backlog E0-3). Changing it later is one small migration while the tables are empty.
EMBED_DIM=1024
