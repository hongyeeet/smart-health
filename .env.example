# Copy this file to .env (git ignores .env) and fill in your own values. Never commit .env.
# The Supabase values are shared with the team through a private channel, never through git or chat logs.

# Kaggle API token, used by scripts/download_data.py for the Kaggle datasets.
# Create it at https://www.kaggle.com/settings (API section). Paste only the token, no quotes.
KAGGLE_API_TOKEN=

# Supabase (the team's one shared project). Backend and scripts only: never put these in apps/web.
# Postgres connection string: Supabase dashboard > Connect > Session pooler (works on IPv4 networks).
# Replace [YOUR-PASSWORD] with the database password; URL-encode symbols such as @ # / in it.
DATABASE_URL=
# Project URL: Project Settings > API > Project URL (looks like https://<ref>.supabase.co).
SUPABASE_URL=
# Secret key: Project Settings > API Keys > the Secret key (its name starts with sb and it says secret) or the legacy service_role key.
# It bypasses row-level security. Server-side only.
SUPABASE_SERVICE_KEY=
# Private Storage bucket for original files (Bronze layer).
STORAGE_BACKEND=supabase
STORAGE_BUCKET=smart-health-originals
# Size of the embedding vectors in knowledge_chunks and memory_episodes (768 since D-048; migration 0016).
EMBED_DIM=768

# --- AI (docs/specs/ai-models.md, docs/specs/learning-loop.md) ---
# Vertex AI express-mode key, used for Gemini (photo reading) and embeddings when no service-account file is set. Server-side only.
GOOGLE_API_KEY=
# Alternative to the key above: a Google Cloud service account (leave blank to use GOOGLE_API_KEY).
GOOGLE_CLOUD_PROJECT=smart-health-510414
GOOGLE_CLOUD_REGION=global
GOOGLE_APPLICATION_CREDENTIALS=
LLM_VISION_MODEL=gemini-3.8-flash
EMBED_MODEL=gemini-embedding-001
# JEV (typed decisions: guards, food types, substitute checks), hosted on OpenRouter.
OPEN_ROUTER_API_KEY=
# JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
# JEV_MODEL=typesafe/jev-1.13

# --- Limits and timers (all optional; these are the defaults) ---
# AI calls per day, one cap for each kind of call. A kind that reaches its cap is refused (safe path) and the others carry on.
# Photo and label reads (meal photos):
# AI_CAP_VERTEX_VISION=300
# Text the person sees (brief findings, medicine explainer, clash checker, chat, onboarding answers):
# AI_CAP_VERTEX_GENERATE=500
# Background embeddings for food search (when blocked, search uses text only):
# AI_CAP_VERTEX_EMBED=2000
# JEV typed decisions (guards and checks):
# AI_CAP_JEV=500
# Any other AI provider uses this cap (the four kinds above have their own):
# AI_DAILY_CALL_CAP=500
# Cost limit in USD, checked for each provider on its own cost (only JEV reports cost today):
# AI_DAILY_BUDGET_USD=5
# New extras (swaps, lunch ideas, walk prompt, check-ins) per day, and the quiet hours (24-hour clock, Singapore time).
# NUDGE_DAILY_CAP=3
# QUIET_START_HOUR=22
# QUIET_END_HOUR=7
# The reminder tick (every minute) and the nightly review run for these people only. Mr Tan is left out on purpose.
# SCHEDULER_ENABLED=true
# SCHEDULER_USERS=mr-tan,demo

# --- Medicine scan (docs/specs/f2-scan.md) and speech ---
# Model for chat and explanations, and the stronger model to try if photo reading is not good enough.
LLM_CHAT_MODEL=gemini-3.8-flash
LLM_VISION_CHALLENGER=gemini-2.5-pro
# A scanned field below this confidence must be typed by the user.
SCAN_CONFIDENCE_THRESHOLD=0.85
# true (default): a local text reader blacks out name, ID, phone and address on a label photo before it is sent, and checks the model's quotes.
# false: the photo is sent as it is (the label's name and address go to the model) and the real photo is not stored. For tests only.
SCAN_OCR_ENABLED=true
# ElevenLabs (text to speech and speech to text). The key comes from the owner.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_LIVE_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2

# Workato: the recipe that adds a medicine's dose times to Google Calendar (docs/specs/f4-calendar.md).
# The webhook address and token come from the recipe's webhook trigger in Workato. Leave blank to skip the calendar step.
WORKATO_WEBHOOK_URL=
WORKATO_WEBHOOK_TOKEN=
# The header the recipe expects the token in (Workato's "auth token" webhook setting uses API-TOKEN).
WORKATO_TOKEN_HEADER=API-TOKEN

# Reminder emails: a SECOND Workato recipe, separate from the calendar one (docs/specs/email-notifications.md). Blank = no emails are sent.
WORKATO_EMAIL_WEBHOOK_URL=
WORKATO_EMAIL_WEBHOOK_TOKEN=
WORKATO_EMAIL_TOKEN_HEADER=API-TOKEN
# Where the button in an email opens the app, and (optional) where the unsubscribe link points: this API as the internet sees it.
APP_BASE_URL=http://localhost:5174
API_PUBLIC_URL=
# Signs the unsubscribe links. Any long random string. Blank = emails carry no unsubscribe link (people turn emails off in Me, Privacy).
NOTIFY_SECRET=
EMAIL_DAILY_CAP=3
