#!/bin/sh
# Blocks commits on uat and main. The team develops on dev only.
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
case "$branch" in
  main|uat)
    if [ "$ALLOW_PROMOTE" != "1" ]; then
      echo "Blocked: do not commit directly to '$branch'."
      echo "Switch to dev (git checkout dev) and work there. Only the owner promotes dev -> uat -> main."
      exit 1
    fi
    ;;
esac
exit 0
