#!/bin/sh
# Blocks pushes to uat and main. The team develops on dev only.
# stdin lines: <local ref> <local sha> <remote ref> <remote sha>
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/uat)
      if [ "$ALLOW_PROMOTE" != "1" ]; then
        echo "Blocked: pushing to '${remote_ref#refs/heads/}' is reserved for the owner."
        echo "Push your work to dev instead (git push origin dev, or a feature/<task-id>-<name> branch)."
        exit 1
      fi
      ;;
  esac
done
exit 0
